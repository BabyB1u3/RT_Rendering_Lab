{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-debug",
        "GLAB_GRAPHICS_BACKEND": "Vulkan"
      }
    },
    {
      "name": "windows-opengl-debug",
      "displayName": "Windows OpenGL Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-opengl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-opengl-debug",
        "GLAB_GRAPHICS_BACKEND": "OpenGL"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-relwithdebinfo",
        "GLAB_GRAPHICS_BACKEND": "Vulkan"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-release",
        "GLAB_GRAPHICS_BACKEND": "Vulkan",
        "GLAB_BUILD_TESTS": "OFF",
        "GLAB_ENABLE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "windows-release-with-tests",
      "displayName": "Windows Release With Tests",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build/windows-release-with-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-release-with-tests",
        "GLAB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows-debug",
      "displayName": "Windows CI Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/ci-windows-debug",
        "GLAB_GRAPHICS_BACKEND": "Vulkan",
        "GLAB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows-opengl-debug",
      "displayName": "Windows CI OpenGL Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows-opengl-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/ci-windows-opengl-debug",
        "GLAB_GRAPHICS_BACKEND": "OpenGL",
        "GLAB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows-release",
      "displayName": "Windows CI Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/ci-windows-release",
        "GLAB_GRAPHICS_BACKEND": "Vulkan",
        "GLAB_BUILD_TESTS": "ON",
        "GLAB_ENABLE_UNITY_BUILD": "ON"
      }
    }
  ]
}
