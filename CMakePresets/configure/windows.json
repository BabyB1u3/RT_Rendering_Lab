      "binaryDir": "${sourceDir}/build/windows-vs-notests",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-vs-notests",
        "GLAB_BUILD_TESTS": "OFF"
