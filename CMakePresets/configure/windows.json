{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-debug"
      }
    },
    {
      "name": "windows-relwithdebinfo",
      "displayName": "Windows RelWithDebInfo",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-relwithdebinfo"
      }
    },
    {
      "name": "windows-release",
      "displayName": "Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-release",
        "GLAB_BUILD_TESTS": "OFF",
        "GLAB_ENABLE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "windows-release-tests",
      "displayName": "Windows Release Tests",
      "inherits": "windows-release",
      "binaryDir": "${sourceDir}/build/windows-release-tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/windows-release-tests",
        "GLAB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows-debug",
      "displayName": "CI Windows Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/ci-windows-debug",
        "GLAB_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci-windows-release",
      "displayName": "CI Windows Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/ci-windows-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/ci-windows-release",
        "GLAB_BUILD_TESTS": "ON",
        "GLAB_ENABLE_UNITY_BUILD": "ON"
      }
    }
  ]
}
