{
  "version": 6,
  "include": [
    "../configure/macos.json"
  ],
  "buildPresets": [
    {
      "name": "build-macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "build-macos-relwithdebinfo",
      "configurePreset": "macos-relwithdebinfo"
    },
    {
      "name": "build-macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "build-macos-release-stage-assets",
      "configurePreset": "macos-release",
      "targets": [
        "rtrlab_stage_shipping_assets"
      ]
    },
    {
      "name": "build-macos-release-stage",
      "configurePreset": "macos-release",
      "targets": [
        "rtrlab_stage_shipping"
      ]
    },
    {
      "name": "build-macos-release-tests",
      "configurePreset": "macos-release-tests"
    },
    {
      "name": "build-ci-macos-debug",
      "configurePreset": "ci-macos-debug"
    },
    {
      "name": "build-ci-macos-release",
      "configurePreset": "ci-macos-release"
    },
    {
      "name": "build-macos-ninja-debug",
      "configurePreset": "macos-ninja-debug"
    },
    {
      "name": "build-macos-ninja-relwithdebinfo",
      "configurePreset": "macos-ninja-relwithdebinfo"
    },
    {
      "name": "build-macos-ninja-release",
      "configurePreset": "macos-ninja-release"
    },
    {
      "name": "build-macos-ninja-release-stage-assets",
      "configurePreset": "macos-ninja-release",
      "targets": [
        "rtrlab_stage_shipping_assets"
      ]
    },
    {
      "name": "build-macos-ninja-release-stage",
      "configurePreset": "macos-ninja-release",
      "targets": [
        "rtrlab_stage_shipping"
      ]
    },
    {
      "name": "build-macos-ninja-release-tests",
      "configurePreset": "macos-ninja-release-tests"
    },
    {
      "name": "build-ci-macos-ninja-debug",
      "configurePreset": "ci-macos-ninja-debug"
    },
    {
      "name": "build-ci-macos-ninja-release",
      "configurePreset": "ci-macos-ninja-release"
    }
