{
  "version": 6,
  "testPresets": [
    {
      "name": "test-base",
      "hidden": true,
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "test-label-common",
      "hidden": true,
      "filter": {
        "include": {
          "label": "common"
        }
      }
    },
    {
      "name": "test-label-dev-profile",
      "hidden": true,
      "filter": {
        "include": {
          "label": "dev-profile"
        }
      }
    },
    {
      "name": "test-label-shipping-profile",
      "hidden": true,
      "filter": {
        "include": {
          "label": "shipping-profile"
        }
      }
    },
    {
      "name": "test-filter-debug-matrix",
      "hidden": true,
      "filter": {
        "include": {
          "name": "^(Unit\\.|Integration\\.|DevProfile\\.)"
        }
      }
    },
    {
      "name": "test-filter-release-matrix",
      "hidden": true,
      "filter": {
        "include": {
          "name": "^(Unit\\.|Integration\\.|ShippingProfile\\.)"
        }
      }
    },
    {
      "name": "test-label-unit",
      "hidden": true,
      "filter": {
        "include": {
          "label": "unit"
        }
      }
    },
    {
      "name": "test-label-integration",
      "hidden": true,
      "filter": {
        "include": {
          "label": "integration"
        }
      }
    }
  ]
}
